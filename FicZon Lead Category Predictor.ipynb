    "# One hot encoding\n",
    "df = pd.get_dummies(df, columns=[\"Product_ID\", \"Source\", \"Sales_Agent\", \"Location\", \"Delivery_Mode\"], drop_first=True, dtype=int)\n",
    "df[\"Target\"] = df[\"Target\"].map({\"High Potential\": 1, \"Low Potential\": 0})\n",
    "df.sample(5)"
   ]
