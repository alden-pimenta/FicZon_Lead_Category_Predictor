    "from sklearn.model_selection import StratifiedKFold, cross_val_score\n",
    "\n",
    "cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=40)\n",
    "cv_models = {\n",
    "    \"Logistic Regression\": (lr_model, X_train_scaled),\n",
    "    \"Naive Bayes\": (nb_model, X_train_scaled),\n",
    "    \"Linear SVM\": (svm_model, X_train_scaled),\n",
    "    \"KNN\": (knn_model, X_train_scaled),\n",
    "    \"Decision Tree\": (DT_model, X_train),\n",
    "    \"Random Forest\": (RF_model, X_train),\n",
    "    \"Gradient Boosting\": (gb_model, X_train),\n",
    "}\n",
    "\n",
    "cv_rows = []\n",
    "for name, (model, Xtr) in cv_models.items():\n",
    "    scores = cross_val_score(model, Xtr, y_train, cv=cv, scoring=\"f1\")\n",
    "    cv_rows.append({\"Model\": name, \"CV F1 mean\": scores.mean(), \"CV F1 std\": scores.std()})\n",
    "\n",
    "cv_results = pd.DataFrame(cv_rows).sort_values(\"CV F1 mean\", ascending=False).reset_index(drop=True)\n",
    "cv_results.round(3)"
   ]
