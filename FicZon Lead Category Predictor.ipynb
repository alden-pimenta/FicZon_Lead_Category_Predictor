   "source": [
    "# A missing mobile number or a broken e-mail may mean a weaker lead, so keep that information as 0/1 features\n",
    "df[\"Has_Mobile\"] = df[\"Mobile\"].notna().astype(int)\n",
    "df[\"Email_Valid\"] = (df[\"EMAIL\"] != \"#VALUE!\").astype(int)\n",
    "\n",
    "for col in [\"Has_Mobile\", \"Email_Valid\"]:\n",
    "    t = df.groupby(col)[\"Target\"].agg(n=\"size\", high_rate=lambda s: round((s == \"High Potential\").mean() * 100, 1))\n",
    "    print(col)\n",
    "    display(t)"
   ]
  },
