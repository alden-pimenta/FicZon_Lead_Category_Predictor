   "source": [
    "# n = number of leads in the group. Small groups can show 100% or 0% just by chance, so always read the rate together with n.\n",
    "for col in [\"Source\", \"Sales_Agent\", \"Location\", \"Delivery_Mode\"]:\n",
    "    t = df.groupby(col)[\"Target\"].agg(n=\"size\", high_rate=lambda s: round((s == \"High Potential\").mean() * 100, 2))\n",
    "    print(f\"\\n\\nHigh Potential rate :  {col}\\n\")\n",
    "    display(t.sort_values(\"high_rate\", ascending=False).head(5))"
   ]
  },
